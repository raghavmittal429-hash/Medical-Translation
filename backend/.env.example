# Backend environment variables for local development and production
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Sarvam AI text-to-speech (best for Indian languages, free tier available).
# Purpose-built for Hindi, Tamil, Telugu, Malayalam, Bengali etc.
# Get a free key (no credit card) at: https://dashboard.sarvam.ai
# Without this, the app falls back to Microsoft Edge TTS -> gTTS automatically.
SARVAM_API_KEY=your_sarvam_api_key_here

# Note: text-to-speech uses a 3-tier fallback chain:
# 1. Sarvam AI Bulbul v3 (best quality for Indian languages, needs key above)
# 2. Microsoft Edge TTS neural voices (free, no key needed)
# 3. gTTS / Google Translate (free, always available)
