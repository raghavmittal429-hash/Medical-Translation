# Backend environment variables for local development and production
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
ALLOWED_ORIGINS=http://127.0.0.1:3000

# ElevenLabs text-to-speech (best voice quality for all 9 languages).
# Free tier: 10,000 characters/month (~10 minutes of audio). No credit card needed.
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# Without this set, the app falls back to Microsoft Edge TTS -> gTTS automatically.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Note: text-to-speech uses a 3-tier fallback chain:
# 1. ElevenLabs Multilingual v2 (best quality, needs key above)
# 2. Microsoft Edge TTS neural voices (free, no key needed)
# 3. gTTS / Google Translate (free, always available)
# See backend/elevenlabs_tts.py and backend/edge_tts_voices.py
